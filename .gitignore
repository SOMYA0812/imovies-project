# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
client/node_modules/
server/node_modules/

# ── Environment variables (NEVER commit these) ────────────────────────────────
.env
.env.local
.env.*.local
server/.env
client/.env
# Allow the example file to be committed
!server/.env.example
!client/.env.example

# ── Build outputs ─────────────────────────────────────────────────────────────
client/dist/
server/dist/
dist/

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── Docker data (local volumes) ───────────────────────────────────────────────
mongo-data/
